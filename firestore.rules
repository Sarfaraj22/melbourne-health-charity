rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isNonEmptyString(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function isValidEmail(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 254
        && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isServerCreatedAt() {
      return request.resource.data.createdAt == request.time;
    }

    function isValidContact(data) {
      return data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'createdAt'])
        && isNonEmptyString(data.name, 200)
        && isValidEmail(data.email)
        && isOptionalString(data.phone, 40)
        && isNonEmptyString(data.subject, 200)
        && isNonEmptyString(data.message, 5000)
        && isServerCreatedAt();
    }

    function isValidAssistance(data) {
      return data.keys().hasOnly(['name', 'email', 'phone', 'need', 'message', 'createdAt'])
        && isNonEmptyString(data.name, 200)
        && isValidEmail(data.email)
        && isOptionalString(data.phone, 40)
        && isNonEmptyString(data.need, 200)
        && isNonEmptyString(data.message, 5000)
        && isServerCreatedAt();
    }

    function isValidDonation(data) {
      return data.keys().hasOnly(['amount', 'frequency', 'name', 'email', 'message', 'createdAt'])
        && data.amount is number
        && data.amount >= 2
        && data.amount <= 1000000
        && (data.frequency == 'one-off' || data.frequency == 'monthly')
        && isNonEmptyString(data.name, 200)
        && isValidEmail(data.email)
        && isOptionalString(data.message, 1000)
        && isServerCreatedAt();
    }

    function isValidInterestList(list) {
      return list is list
        && list.size() > 0
        && list.size() <= 5
        && list.hasOnly(['event-support', 'companionship', 'admin', 'outdoor', 'mentoring']);
    }

    function isValidVolunteerApplication(data) {
      return data.keys().hasOnly([
          'name', 'email', 'phone', 'address', 'interests', 'availability',
          'message', 'status', 'createdAt'
        ])
        && isNonEmptyString(data.name, 200)
        && isValidEmail(data.email)
        && isNonEmptyString(data.phone, 40)
        && isNonEmptyString(data.address, 300)
        && isValidInterestList(data.interests)
        && data.availability in ['weekday', 'weekend', 'evening', 'flexible']
        && isOptionalString(data.message, 5000)
        && data.status == 'pending'
        && isServerCreatedAt();
    }

    function isValidOwnerUserId(value) {
      return value is string
        && value.size() <= 128
        && (
          (request.auth == null && value == '')
          || (request.auth != null && value == request.auth.uid)
        );
    }

    function isOwnerDoc(data) {
      return request.auth != null
        && data.userId is string
        && data.userId.size() > 0
        && data.userId == request.auth.uid;
    }

    function isValidEventRegistration(data) {
      return data.keys().hasOnly([
          'eventSlug', 'userId', 'name', 'email', 'phone', 'attendees',
          'accessibilityRequirements', 'optInUpdates', 'createdAt'
        ])
        && isNonEmptyString(data.eventSlug, 200)
        && isValidOwnerUserId(data.userId)
        && isNonEmptyString(data.name, 200)
        && isValidEmail(data.email)
        && isNonEmptyString(data.phone, 40)
        && isNonEmptyString(data.attendees, 10)
        && isOptionalString(data.accessibilityRequirements, 2000)
        && data.optInUpdates is bool
        && isServerCreatedAt();
    }

    function isValidAppointment(data) {
      return data.keys().hasOnly([
          'userId', 'name', 'date', 'time', 'serviceSlug', 'supportType',
          'accessibilityRequirements', 'transportRequired', 'createdAt'
        ])
        && isValidOwnerUserId(data.userId)
        && isNonEmptyString(data.name, 200)
        && isNonEmptyString(data.date, 20)
        && isNonEmptyString(data.time, 20)
        && isNonEmptyString(data.serviceSlug, 200)
        && data.supportType in ['in-person', 'telehealth', 'phone']
        && isOptionalString(data.accessibilityRequirements, 2000)
        && (data.transportRequired == 'yes' || data.transportRequired == 'no')
        && isServerCreatedAt();
    }

    function isUserRole() {
      return request.auth != null
        && request.auth.token.role != 'admin'
        && request.auth.token.role != 'volunteer';
    }

    function isVolunteer() {
      return request.auth != null
        && request.auth.token.role == 'volunteer';
    }

    function isValidInboxMessage(data) {
      return data.keys().hasOnly(['userId', 'sender', 'body', 'fromRole', 'createdAt'])
        && isNonEmptyString(data.userId, 128)
        && isNonEmptyString(data.sender, 200)
        && isNonEmptyString(data.body, 8000)
        && data.fromRole in ['admin', 'user', 'volunteer']
        && isServerCreatedAt();
    }

    function canCreateInboxMessage(data) {
      return isValidInboxMessage(data)
        && (
          (isAdmin() && data.fromRole == 'admin')
          || (
            request.auth != null
            && data.userId == request.auth.uid
            && (
              (data.fromRole == 'user' && isUserRole())
              || (data.fromRole == 'volunteer' && isVolunteer())
            )
          )
        );
    }

    function isValidProfileCreate(data, uid) {
      return data.keys().hasOnly(['uid', 'displayName', 'email', 'role', 'createdAt'])
        && data.uid == uid
        && request.auth != null
        && request.auth.uid == uid
        && isNonEmptyString(data.displayName, 200)
        && isValidEmail(data.email)
        && data.role == 'user'
        && isServerCreatedAt();
    }

    function isValidLiveChat(data) {
      return data.keys().hasOnly([
          'guestName', 'guestEmail', 'origin', 'userId', 'status', 'createdAt', 'updatedAt'
        ])
        && isNonEmptyString(data.guestName, 200)
        && isValidEmail(data.guestEmail)
        && data.origin in ['visitor', 'registered']
        && data.userId is string
        && data.userId.size() <= 128
        && data.status == 'open'
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (
          (data.origin == 'visitor' && data.userId == '')
          || (
            data.origin == 'registered'
            && request.auth != null
            && data.userId == request.auth.uid
            && isUserRole()
          )
        );
    }

    function isValidLiveChatMessage(data) {
      return data.keys().hasOnly(['sender', 'body', 'createdAt'])
        && data.sender in ['visitor', 'user', 'volunteer', 'admin']
        && isNonEmptyString(data.body, 2000)
        && isServerCreatedAt();
    }

    function isValidMessageThread(data) {
      return data.keys().hasOnly(['participantUids', 'initiatedByUid', 'createdAt', 'updatedAt'])
        && data.participantUids is list
        && data.participantUids.size() == 2
        && isNonEmptyString(data.initiatedByUid, 128)
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && request.auth != null
        && request.auth.uid in data.participantUids
        && data.initiatedByUid == request.auth.uid;
    }

    function otherThreadParticipant(uids) {
      return uids[0] == request.auth.uid ? uids[1] : uids[0];
    }

    function canCreateMessageThread(data) {
      return isValidMessageThread(data)
        && (
          isAdmin()
          || (
            isVolunteer()
            && exists(/databases/$(database)/documents/profiles/$(otherThreadParticipant(data.participantUids)))
            && get(/databases/$(database)/documents/profiles/$(otherThreadParticipant(data.participantUids))).data.role == 'admin'
          )
        );
    }

    function isThreadParticipant() {
      return request.auth != null
        && resource.data.participantUids is list
        && request.auth.uid in resource.data.participantUids;
    }

    function isValidThreadMessage(data) {
      return data.keys().hasOnly(['senderUid', 'sender', 'fromRole', 'body', 'createdAt'])
        && request.auth != null
        && data.senderUid == request.auth.uid
        && isNonEmptyString(data.sender, 200)
        && data.fromRole in ['admin', 'user', 'volunteer']
        && isNonEmptyString(data.body, 8000)
        && isServerCreatedAt()
        && (
          (isAdmin() && data.fromRole == 'admin')
          || (isUserRole() && data.fromRole == 'user')
          || (isVolunteer() && data.fromRole == 'volunteer')
        );
    }

    function isValidEmailRecord(data) {
      return data.keys().hasOnly([
          'to', 'fromAddress', 'subject', 'body', 'source', 'folder',
          'threadId', 'contactId', 'createdAt'
        ])
        && isValidEmail(data.to)
        && isNonEmptyString(data.fromAddress, 254)
        && isNonEmptyString(data.subject, 200)
        && isNonEmptyString(data.body, 8000)
        && data.source in ['compose', 'bulk', 'contact', 'inbound']
        && data.folder in ['inbox', 'sent']
        && data.threadId is string
        && data.threadId.size() <= 128
        && data.contactId is string
        && data.contactId.size() <= 128
        && isServerCreatedAt();
    }

    function isValidSavedResource(data) {
      return data.keys().hasOnly(['userId', 'resourceId', 'createdAt'])
        && request.auth != null
        && data.userId == request.auth.uid
        && isNonEmptyString(data.userId, 128)
        && isNonEmptyString(data.resourceId, 200)
        && isServerCreatedAt();
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.role == 'admin';
    }

    function isValidVolunteerRecord(data) {
      return data.keys().hasOnly([
          'name', 'email', 'phone', 'address', 'status', 'trainingPercent',
          'hours', 'authUid', 'coordinatorUid', 'createdAt'
        ])
        && isNonEmptyString(data.name, 200)
        && isValidEmail(data.email)
        && isOptionalString(data.phone, 40)
        && isOptionalString(data.address, 300)
        && data.status in ['active', 'pending']
        && data.trainingPercent is number
        && data.trainingPercent >= 0
        && data.trainingPercent <= 100
        && data.hours is number
        && data.hours >= 0
        && data.authUid is string
        && data.authUid.size() <= 128
        && data.coordinatorUid is string
        && data.coordinatorUid.size() <= 128
        && isServerCreatedAt();
    }

    function volunteerAuthUid(volunteerId) {
      return exists(/databases/$(database)/documents/volunteers/$(volunteerId))
        && get(/databases/$(database)/documents/volunteers/$(volunteerId)).data.authUid is string
        && get(/databases/$(database)/documents/volunteers/$(volunteerId)).data.authUid.size() > 0
        && get(/databases/$(database)/documents/volunteers/$(volunteerId)).data.authUid == request.auth.uid;
    }

    function isValidEventRecord(data) {
      return data.keys().hasOnly([
          'title', 'slug', 'summary', 'description', 'date', 'time', 'location', 'status', 'createdAt'
        ])
        && isNonEmptyString(data.title, 200)
        && isNonEmptyString(data.slug, 200)
        && isOptionalString(data.summary, 500)
        && isOptionalString(data.description, 5000)
        && isNonEmptyString(data.date, 40)
        && isOptionalString(data.time, 40)
        && isOptionalString(data.location, 200)
        && data.status in ['published', 'draft']
        && isServerCreatedAt();
    }

    function isValidVolunteerHours(data) {
      return data.keys().hasOnly([
          'volunteerId', 'volunteerName', 'hours', 'month', 'createdAt'
        ])
        && isNonEmptyString(data.volunteerId, 200)
        && isNonEmptyString(data.volunteerName, 200)
        && data.hours is number
        && data.hours > 0
        && isNonEmptyString(data.month, 7)
        && isServerCreatedAt();
    }

    function isValidReport(data) {
      return data.keys().hasOnly(['title', 'type', 'createdAt'])
        && isNonEmptyString(data.title, 200)
        && isNonEmptyString(data.type, 100)
        && isServerCreatedAt();
    }

    match /contact_messages/{id} {
      allow read: if isAdmin();
      allow create: if isValidContact(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['repliedAt']);
      allow delete: if false;
    }

    match /assistance_requests/{id} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isValidAssistance(request.resource.data);
    }

    match /donations/{id} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isValidDonation(request.resource.data);
    }

    match /volunteer_applications/{id} {
      allow read: if isAdmin();
      allow update, delete: if false;
      allow create: if isValidVolunteerApplication(request.resource.data);
    }

    match /event_registrations/{id} {
      allow read: if isAdmin() || isOwnerDoc(resource.data);
      allow update, delete: if false;
      allow create: if isValidEventRegistration(request.resource.data);
    }

    match /appointments/{id} {
      allow read: if isAdmin() || isOwnerDoc(resource.data);
      allow update, delete: if false;
      allow create: if isValidAppointment(request.resource.data);
    }

    match /messages/{id} {
      allow read: if isAdmin() || isOwnerDoc(resource.data);
      allow create: if canCreateInboxMessage(request.resource.data);
      allow update, delete: if false;
    }

    match /profiles/{uid} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create: if isValidProfileCreate(request.resource.data, uid);
      allow update, delete: if isAdmin();
    }

    match /saved_resources/{id} {
      allow read: if isAdmin() || isOwnerDoc(resource.data);
      allow create: if isValidSavedResource(request.resource.data);
      allow delete: if isOwnerDoc(resource.data);
      allow update: if false;
    }

    match /volunteers/{id} {
      allow read: if isAdmin()
        || (request.auth != null
          && resource.data.authUid == request.auth.uid
          && resource.data.authUid is string
          && resource.data.authUid.size() > 0);
      allow create: if isAdmin() && isValidVolunteerRecord(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.status in ['active', 'pending']
        && request.resource.data.trainingPercent is number
        && request.resource.data.trainingPercent >= 0
        && request.resource.data.trainingPercent <= 100
        && request.resource.data.hours is number
        && request.resource.data.hours >= 0
        && request.resource.data.authUid is string
        && request.resource.data.authUid.size() <= 128
        && isOptionalString(request.resource.data.address, 300);
      allow delete: if isAdmin();
    }

    match /events/{id} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create: if isAdmin() && isValidEventRecord(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.status in ['published', 'draft'];
      allow delete: if isAdmin();
    }

    match /volunteer_hours/{id} {
      allow read: if isAdmin()
        || (request.auth != null && volunteerAuthUid(resource.data.volunteerId));
      allow create: if isAdmin() && isValidVolunteerHours(request.resource.data);
      allow update, delete: if false;
    }

    match /reports/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidReport(request.resource.data);
      allow update, delete: if false;
    }

    match /live_chats/{chatId} {
      allow get: if true;
      allow list: if isAdmin()
        || isVolunteer()
        || (request.auth != null
          && resource.data.userId == request.auth.uid
          && resource.data.userId is string
          && resource.data.userId.size() > 0);
      allow create: if isValidLiveChat(request.resource.data);
      allow update: if isAdmin()
        || isVolunteer()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidLiveChatMessage(request.resource.data)
          && (
            (request.resource.data.sender == 'visitor' && request.auth == null)
            || (
              request.resource.data.sender == 'user'
              && isUserRole()
              && get(/databases/$(database)/documents/live_chats/$(chatId)).data.userId == request.auth.uid
            )
            || (isVolunteer() && request.resource.data.sender == 'volunteer')
            || (isAdmin() && request.resource.data.sender == 'admin')
          );
        allow update, delete: if false;
      }
    }

    match /message_threads/{threadId} {
      allow read: if isAdmin() || isThreadParticipant();
      allow create: if canCreateMessageThread(request.resource.data);
      allow update: if (isAdmin() || isThreadParticipant())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (
            request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/message_threads/$(threadId)).data.participantUids
          );
        allow create: if isValidThreadMessage(request.resource.data)
          && (
            isAdmin()
            || (
              request.auth != null
              && request.auth.uid in get(/databases/$(database)/documents/message_threads/$(threadId)).data.participantUids
            )
          );
        allow update, delete: if false;
      }
    }

    match /emails/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidEmailRecord(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
